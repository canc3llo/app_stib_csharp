<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:maui_app"
             x:Class="maui_app.MainPage">

<ContentPage.Resources>
    <Style x:Key="SquareImage" TargetType="Image">
        <Setter Property="HorizontalOptions" Value="Fill"/>
        <Setter Property="VerticalOptions" Value="Fill"/>
        <Style.Behaviors>
            <local:SquareBehavior/>
        </Style.Behaviors>
    </Style>
</ContentPage.Resources>

    <Grid Padding="20, 10, 20, 0" RowDefinitions="*,Auto">
        <Grid x:Name="LinesGrid" Grid.Row="0" IsVisible="False" Padding="0" BackgroundColor="LightCoral" RowDefinitions="Auto,*">

            <BoxView Grid.Row="0" BackgroundColor="LightBlue"/>
            <!-- Menu de filtre -->
            <HorizontalStackLayout x:Name="FilterMenu"
                                   Grid.Row="0" Spacing="10"
                                   Margin="0, 10"
                                   HorizontalOptions="Center">
                <Button Text="Tous" Clicked="OnAllClicked"/>
                <Button Text="Bus" Clicked="OnBusClicked"/>
                <Button Text="Tram" Clicked="OnTramClicked"/>
                <Button Text="Métro" Clicked="OnMetroClicked"/>
            </HorizontalStackLayout>

            <BoxView Grid.Row="1" BackgroundColor="LightGreen"/>
            <!-- Grille de lignes -->
            <ScrollView x:Name="LinesView"
                        Grid.Row="1" BackgroundColor="AliceBlue"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill"
                        Margin="0"
                        Orientation="Vertical">

                <CollectionView ItemsSource="{Binding DisplayedLines}">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical"
                                          Span="6"
                                          HorizontalItemSpacing="10"
                                          VerticalItemSpacing="10"/>
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Image Source="{Binding ImageSource}"
                                   Aspect="AspectFill"
                                   Style="{StaticResource SquareImage}">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnLineTapped" CommandParameter="{Binding .}"/>
                                    </Image.GestureRecognizers>
                            </Image>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </ScrollView>
        </Grid>

        <Grid x:Name="FavorisGrid" Grid.Row="0" IsVisible="True" Padding="0" BackgroundColor="LightCoral" RowDefinitions="30*,70*">
            <VerticalStackLayout Grid.Row="0" BackgroundColor="AliceBlue"
                                  VerticalOptions="Center"
                                  HorizontalOptions="Center">
                
                <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Label x:Name="WeatherIconLabel"
                           Text="⏳"
                           FontSize="32"
                           VerticalOptions="Center"/>
                    <Label x:Name="WeatherLabel"
                           Text="Chargement..."
                           FontSize="20"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>
                <Label Text="Bruxelles"
                       FontSize="20"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>
            
            <Border Grid.Row="1"
                    Margin="20, 10"
                    Stroke="DarkGray"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="LightGreen">
                <CollectionView HorizontalOptions="Fill" VerticalOptions="Fill">

                </CollectionView>
            </Border>
        </Grid>

        <HorizontalStackLayout Grid.Row="1" Spacing="10" Margin="0, 10, 0, 5" HorizontalOptions="Center">
            <Button Text="Fav" Clicked="OnFavClicked"/>
            <Button Text="Lignes" Clicked="OnLignesClicked"/>
        </HorizontalStackLayout>

    </Grid>
</ContentPage>