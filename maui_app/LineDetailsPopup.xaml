<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:maui_app"
             x:Class="maui_app.LineDetailsPopup"
             HorizontalOptions="Fill"
             VerticalOptions="Fill"
             Padding="0">

    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*, auto" BackgroundColor="#0077c0" SafeAreaEdges="None">
            <Image Grid.Column="0"
                   x:Name="TitleImage"
                   HeightRequest="50"
                   WidthRequest="50"
                   Aspect="AspectFit"
                   VerticalOptions="Center"
                   HorizontalOptions="Start"
                   Margin="5"/>
            
            <HorizontalStackLayout Grid.Column="1"
                                   Spacing="5"
                                   VerticalOptions="Center"
                                   Margin="5">
                <Border StrokeShape="RoundRectangle 12">
                <Button Text="🔃"
                        Clicked="OnSwapDirectionClicked"
                        BackgroundColor="White"
                        TextColor="Black"
                        FontSize="24"
                        Padding="0"
                        WidthRequest="40"
                        HeightRequest="40"/>
                </Border>
            
                <Border StrokeShape="RoundRectangle 12">
                <Button x:Name="btnfavoris"
                        Text="❤️"
                        Clicked="OnFavorisClicked"
                        BackgroundColor="White"
                        TextColor="Black"
                        FontSize="24"
                        Padding="0"
                        WidthRequest="40"
                        HeightRequest="40"/>
                </Border>
                
                <Border StrokeShape="RoundRectangle 12">
                <Button Text="✕"
                        Clicked="OnCloseClicked"
                        BackgroundColor="White"
                        FontAttributes="Bold"
                        TextColor="Black"
                        FontSize="24"
                        Padding="0"
                        WidthRequest="40"
                        HeightRequest="40"/>
                </Border>
            </HorizontalStackLayout>
        </Grid>

        <Grid Grid.Row="1" RowDefinitions="Auto,*" BackgroundColor="White">
            <Label x:Name="DirectionLabel"
                   Grid.Row="0"
                   Text=""
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="White"
                   BackgroundColor="#0077c0"
                   Padding="12,8"/>

            <CollectionView Grid.Row="1"
                             ItemsSource="{Binding Stops}"
                             BackgroundColor="White">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="local:RouteStop">
                        <Grid ColumnDefinitions="5*,55*,40*" Padding="10,0">
                            <Grid Grid.Column="0" HorizontalOptions="Center" HeightRequest="40">
                                <BoxView WidthRequest="4"
                                         Color="Red"
                                         VerticalOptions="Fill"
                                         HorizontalOptions="Center"/>
                                <Ellipse WidthRequest="14"
                                         HeightRequest="14"
                                         Fill="White"
                                         Stroke="Red"
                                         StrokeThickness="3"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center">
                                    <Ellipse.Triggers>
                                        <DataTrigger TargetType="Ellipse" Binding="{Binding IsTerminus}" Value="True">
                                            <Setter Property="WidthRequest" Value="20"/>
                                            <Setter Property="HeightRequest" Value="20"/>
                                            <Setter Property="Fill" Value="White"/>
                                        </DataTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                            </Grid>

                            <Label Grid.Column="1"
                                   Text="{Binding Name}"
                                   FontSize="16"
                                   VerticalOptions="Center"
                                   Margin="10,0,0,0">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsTerminus}" Value="True">
                                        <Setter Property="FontAttributes" Value="Bold"/>
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            
                            <HorizontalStackLayout Grid.Column="2"
                                                   VerticalOptions="Center"
                                                   HorizontalOptions="Center"
                                                   Margin="0,0">
                                <Label
                                    Text="{Binding Time1}"
                                    Margin="15,0">
                                </Label>
                                <Label
                                    Text="{Binding Time2}"
                                    Margin="15,0">
                                </Label>
                            </HorizontalStackLayout>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>

</ContentView>
